# Definitions for Sway config

# Logo key. Use Mod1 for Alt.
set $mod Mod4
set $alt Mod1
# Home row direction keys, like vim
set $left  h
set $down  j
set $up    k
set $right l

# Application defintiions
set $menu {{ .launcher }}
set $browser {{ .browser }}{{ if .browserFlags }} {{ .browserFlags }}{{ end }}
set $terminal {{ .terminal }}
set $fm {{ .fileManager }}
set $screenshot grim ~/Pictures/screenshot/scrn-$(date +"%Y-%m-%d-%H-%M-%S").png
set $screenclip slurp | grim -g - ~/Pictures/screenshot/scrn-$(date +"%Y-%m-%d-%H-%M-%S").png
